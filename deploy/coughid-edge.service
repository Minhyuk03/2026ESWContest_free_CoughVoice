# 라즈베리파이 엣지 상주 서비스
#
# 설치:
#   sudo cp coughid-edge.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now coughid-edge
#
# 확인:  systemctl status coughid-edge · journalctl -u coughid-edge -f
#
# 서버 주소는 IP가 아니라 mDNS 이름을 쓴다. 공유기가 IP를 바꿔도 끊기지 않는다.
# 네트워크가 늦게 붙는 부팅 직후를 대비해 network-online.target을 기다린다.
#
# ⚠ **/etc/hosts 항목이 반드시 있어야 한다** (2026-08-25 장애):
#     echo "192.168.219.134 mhui-Macmini.local mhui-macmini.local" | sudo tee -a /etc/hosts
#   이 집 공유기 환경에서 파이의 .local 해석이 간헐적으로 실패한다
#   (Failed to resolve 'mhui-macmini.local' / connect timeout). 그때마다 이벤트가
#   디스크 큐로 밀리는데, 큐가 커지면 SD 카드를 채운다. 실제로 4,314파일 177MB까지
#   자랐고 여유가 977MB(93% 사용)까지 떨어졌다.
#   requests가 호스트명을 소문자로 바꾸므로 **대소문자 두 형태 모두** 넣는다.
#   IP가 바뀌면 이 줄과 /etc/hosts를 함께 고친다.
[Unit]
Description=Cough-ID edge (capture -> detect -> send)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=mh
WorkingDirectory=/home/mh/Cough_EmbeddedSystem/edge
Environment=PYTHONUNBUFFERED=1
# 장치 인증 토큰(선택). 서버에도 같은 COUGHID_DEVICE_TOKEN을 설정하면 POST /events·
# /heartbeat가 이 토큰을 요구해 LAN의 가짜 이벤트 주입을 막는다. 양쪽 값이 같아야 하며,
# main.py가 이 환경변수를 자동으로 읽어 X-Device-Token으로 보낸다.
#Environment=COUGHID_DEVICE_TOKEN=여기에-공유-비밀값
ExecStart=/home/mh/Cough_EmbeddedSystem/monitor/.venv/bin/python main.py \
    --server http://mhui-Macmini.local:8000 \
    --device 0 \
    --gain 5 \
    --threshold 0.10
Restart=always
RestartSec=5
# 마이크를 다른 프로세스가 잡고 있으면 실패하므로 재시도 간격을 둔다
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
